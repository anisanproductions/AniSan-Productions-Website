---
import logo from '../assets/navbar-buttons/logo.png';

import now from '../assets/navbar-buttons/now.png';
import projects from '../assets/navbar-buttons/projects.png';
import blog from '../assets/navbar-buttons/blog.png';
import links from '../assets/navbar-buttons/links.png';

import youtube from '../assets/navbar-buttons/youtube.png';
import wattpad from '../assets/navbar-buttons/wattpad.png';
import soundcloud from '../assets/navbar-buttons/soundcloud.png';
import itchio from '../assets/navbar-buttons/itchio.png';
---

<div class="navbar">
    <a href="/">
        <img src={logo.src} class="logo">
    </a>

    <div class="menu">
        <a href="/now"><img src={now.src}></a>
        <a href="/projects"><img src={projects.src}></a>
        <a href="https://anisanproductions.blogspot.com/"><img src={blog.src}></a>
        <a href="https://linktr.ee/anisanproductions"><img src={links.src}></a>
    </div>

</div>


<style>
/* NAVBAR styles stay here OR move to Navbar later */
.navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
}

/* LEFT (logo) */
.logo {
    height: 100px;
}

/* CENTER (menu) */
.menu {
    display: flex;
    gap: 35px;
    align-items: center;
}

.menu img {
    height: 60px;
}

/* RIGHT (social icons) */
.icons {
    display: flex;
    gap: 15px;
    align-items: center;
}

.icons img {
    height: 50px;
    display: block;
}
</style>
