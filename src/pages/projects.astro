---
import MainLayout from '../layouts/MainLayout.astro';

import banner from '../assets/banners/projectsbanner.png';

import current from '../assets/button-images/projects-currentthings.png';
import future from '../assets/button-images/projects-futurethings.png';
import interests from '../assets/button-images/projects-interests.png';
import listall from '../assets/button-images/projects-listall.png';
import artifacts from '../assets/button-images/projects-artifacts.png';
---

<MainLayout title="AniSan Productions | Projects">

    <!-- HERO -->
    <div class="hero">
        <img src={banner.src} class="banner">

        <div class="hero-text">
            <div class="small">Sorted by:</div>
            <div class="big"></div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="image-row">
        <a href="/current"><img src={current.src} alt="Image 1"></a>
        <a href="/future"><img src={future.src} alt="Image 2"></a>
        <a href="/interests"><img src={interests.src} alt="Image 3"></a>
        <a href="/artifacts"><img src={artifacts.src} alt="Image 4"></a>
        <a href="/all-productions"><img src={listall.src} alt="Image 5"></a>
    </div>

</MainLayout>

<style>

.hero {
    position: relative;
    margin-top: 10px;
}

.banner {
    width: 100%;
    display: block;
}

.hero-text {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: white;
}

.hero-text .small {
    font-size: 25px;
    letter-spacing: 2px;
}

.hero-text .big {
    font-size: 42px;
}

.content {
    display: flex;
    gap: 40px;
    margin-top: 40px;
    justify-content: center;
}

.main-image {
    width: 450px;
    border: 8px solid #cfcfcf;
}

.text {
    max-width: 500px;
    color: white;
    font-size: 24px;
}

.image-row {
  display: flex;
  justify-content: center; /* Centers the whole row */
  align-items: center;
  gap: 10px;               /* Adds equal spacing between each image */
  margin-top: 40px;        /* Pushes the row down from the hero banner */
  padding: 0 20px;         /* Prevents images from touching screen edges */
}

.image-row img {
  width: 100%;
  height: auto;
}


</style>