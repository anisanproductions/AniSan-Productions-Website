---
import MainLayout from '../../layouts/MainLayout.astro';

import banner from '../../assets/banners/myinterestsbanner.png';
import picture from '../../assets/site-images/interests.png'

---

<MainLayout title="AniSan Productions | Interests">

    <!-- HERO -->
    <div class="hero">
        <img src={banner.src} class="banner">


        <div class="hero-text">
            <div class="small">click one!</div>
        </div>
    </div>

    <!-- RESPONSIVE INTERACTIVE CONTAINER -->
    <div class="interactive-container">
        <img src={picture.src} class="picture" alt="Interests">
        
        <!-- Clickable Areas using percentages -->
        <a href="/interests/blender" class="hotspot blender" title="3D Modeling & Animation"></a>
        <a href="/interests/escritura" class="hotspot escritura" title="Writing"></a>
        <a href="/interests/violin" class="hotspot violin" title="Violin"></a>
        <a href="/interests/piano" class="hotspot piano" title="Piano"></a>
        <a href="/interests/edicion" class="hotspot edicion" title="Audio & Video Editing"></a>
        <a href="/interests/composicion" class="hotspot composicion" title="Musical Composition"></a>
        <a href="/interests/animacion" class="hotspot animacion" title="Animation 2D"></a>
        <a href="/interests/poesia" class="hotspot poesia" title="Poetry"></a>
        <a href="/interests/programacion" class="hotspot programacion" title="Programming"></a>
        <a href="/interests/dibujo" class="hotspot dibujo" title="Drawing & Visual Arts"></a>
        <a href="/interests/ingles" class="hotspot ingles" title="English Language"></a>
    </div>


</MainLayout>

<style>
/* --- FIX: Limpiamos los estilos duplicados de .picture y manejamos el espacio --- */
.picture {
    display: block;
    width: 100%;
    height: auto;
}

.hero {
    position: relative;
    margin-top: 10px;
    margin-bottom: 10px; /* Le da espacio al texto "click one!" sin empujar las cajas */
}

.banner {
    width: 100%;
    display: block;
}

.hero-text {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: white;
    width: 100%; /* Asegura que el texto esté centrado correctamente */
}

.hero-text .small {
    font-size: 25px;
    letter-spacing: 2px;
}

.hero-text .big {
    font-size: 42px;
}

.content {
    display: flex;
    gap: 40px;
    margin-top: 40px;
    justify-content: center;
}

.main-image {
    width: 450px;
    border: 8px solid #cfcfcf;
}

.text {
    max-width: 500px;
    color: white;
    font-size: 24px;
}

.image-row {
  display: flex;
  justify-content: center; 
  align-items: center;
  gap: 10px;               
  margin-top: 40px;        
  padding: 0 20px;         
}

.image-row img {
  width: 100%;
  height: auto;
}

/* Container that scales fluidly and handles absolute positioning */
.interactive-container {
    position: relative;
    width: 100%;
    display: inline-block;
    margin-top: 20px; /* Separación limpia desde el texto del héroe */
}

/* Base style for all clickable regions */
.hotspot {
    position: absolute;
    display: block;
    /* Para pruebas: descomenta la línea de abajo si quieres ver dónde están paradas las cajas */
    /* border: 2px solid red; background: rgba(255, 0, 0, 0.2); */
}

/* Individual coordinate conversions to percentages */
.programacion { top: 3.8%;  left: 5.9%;   width: 22.5%; height: 25.5%; }
.dibujo {       top: 1.2%;  left: 39.0%;  width: 18.4%; height: 24.0%; }
.ingles {       top: 6.2%;  left: 65.8%;  width: 19.6%; height: 24.5%; }

.edicion {      top: 37.2%; left: 1.7%;   width: 19.5%; height: 27.4%; }
.composicion {  top: 30.6%; left: 24.1%;  width: 22.0%; height: 23.3%; }
.animacion {    top: 32.7%; left: 51.1%;  width: 24.0%; height: 27.1%; }
.poesia {       top: 32.5%; left: 79.1%;  width: 18.1%; height: 25.0%; }

.blender {      top: 71.5%; left: 6.1%;   width: 19.5%; height: 26.3%; }
.escritura {    top: 55.9%; left: 30.0%;  width: 17.0%; height: 22.5%; }
.violin {       top: 62.4%; left: 49.0%;  width: 18.7%; height: 24.4%; }
.piano {        top: 69.1%; left: 74.3%;  width: 19.8%; height: 28.5%; }
</style>