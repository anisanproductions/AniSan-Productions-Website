---
import MainLayout from '../layouts/MainLayout.astro';

import banner from '../assets/banners/currentthingsbanner.png';

import { getCollection } from 'astro:content';

const productions = await getCollection('productions');

import CurrentBlocks from '../components/CurrentBlocks.astro';

const currentThings = productions
  .filter(production => production.data.status === 'current')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MainLayout title="AniSan Productions | Current Things">

    <!-- HERO -->
    <div class="hero">
        <img src={banner.src} class="banner">
    </div>

    <div class="current-list">
        {currentThings.map(production => (
          <CurrentBlocks production={production} />
        ))}
    </div>

</MainLayout>

<style>

.hero {
    position: relative;
    margin-top: 10px;
}

.banner {
    width: 100%;
    display: block;
}

.hero-text {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: white;
}

.hero-text .small {
    font-size: 25px;
    letter-spacing: 2px;
}

.hero-text .big {
    font-size: 42px;
}

.content {
    display: flex;
    gap: 40px;
    margin-top: 40px;
    justify-content: center;
}

.main-image {
    width: 450px;
    border: 8px solid #cfcfcf;
}

.text {
    max-width: 500px;
    color: white;
    font-size: 24px;
}

.image-row {
  display: flex;
  justify-content: center; /* Centers the whole row */
  align-items: center;
  gap: 10px;               /* Adds equal spacing between each image */
  margin-top: 40px;        /* Pushes the row down from the hero banner */
  padding: 0 20px;         /* Prevents images from touching screen edges */
}

.image-row img {
  width: 100%;
  height: auto;
}


.current-list {
    width: min(1150px, 92%);
    margin: 12px auto;

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    column-gap: 16px;
    row-gap: 18px;
}

@media (max-width: 750px) {
    .current-list {
      grid-template-columns: 1fr;
    }
}
</style>