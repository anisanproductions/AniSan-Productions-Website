---
import { getCollection, render } from 'astro:content';

const productions = await getCollection('productions');

const poems = productions.filter(
  item => item.data.mainInterests && item.data.mainInterests.includes('Poetry')
);

// Sort the poems descending (newest first)
poems.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Get the total count so we can calculate the publish number
const totalPoems = poems.length;
---

