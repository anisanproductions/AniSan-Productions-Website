---
import MainLayout from '../layouts/MainLayout.astro';

import banner from '../assets/banners/futurethingsbanner.png';

import { getCollection } from 'astro:content';

const productions = await getCollection('productions');

const currentThings = productions.filter(
  production => production.data.status === 'future'
);

---

<MainLayout title="AniSan Productions | Future Things">

    <!-- HERO -->
    <div class="hero">
        <img src={banner.src} class="banner">
    </div>


</MainLayout>

<style>

.hero {
    position: relative;
    margin-top: 10px;
}

.banner {
    width: 100%;
    display: block;
}

.hero-text {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: white;
}

.hero-text .small {
    font-size: 25px;
    letter-spacing: 2px;
}

.hero-text .big {
    font-size: 42px;
}

.content {
    display: flex;
    gap: 40px;
    margin-top: 40px;
    justify-content: center;
}

.main-image {
    width: 450px;
    border: 8px solid #cfcfcf;
}

.text {
    max-width: 500px;
    color: white;
    font-size: 24px;
}

.image-row {
  display: flex;
  justify-content: center; /* Centers the whole row */
  align-items: center;
  gap: 10px;               /* Adds equal spacing between each image */
  margin-top: 40px;        /* Pushes the row down from the hero banner */
  padding: 0 20px;         /* Prevents images from touching screen edges */
}

.image-row img {
  width: 100%;
  height: auto;
}
</style>