---
import Navbar from '../components/Navbar.astro';
import bg from '../assets/truebackground.png';
import font from '../assets/Anisanfonttest3-Regular.woff2';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AniSan Productions</title>

    <link rel="icon" href="/truewhat.ico">
</head>

<body style={`background-image: url(${bg.src});`}>
    <div class="container">
        <Navbar />
        <slot />
    </div>
</body>

<style>
@font-face {
    font-family: 'AniSanFont';
    src: url('${font}') format('woff2');
    font-weight: normal;
    font-style: normal;
}

body {
    margin: 0;
    background-repeat: repeat;
    background-size: auto;
    font-family: 'AniSanFont';
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}




</style>