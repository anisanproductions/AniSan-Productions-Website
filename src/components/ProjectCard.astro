---
const { project } = Astro.props;
const data = project.data;
---

<a href={`/projects/${project.id}/`} class="project-card">

  {
    data.thumbnail && (
      <img
        src={data.thumbnail}
        alt={data.title}
      />
    )
  }

  <h2>{data.title}</h2>

  <p>{data.description}</p>

  <p>{data.status}</p>

</a>


