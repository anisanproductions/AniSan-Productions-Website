---
import { getCollection } from 'astro:content';
import PoemList from '../../components/PoemList.astro';

const productions = await getCollection('productions');

const poems = productions.filter(
  item =>
    item.data.mainInterests.includes('Poetry')
);
import favicon from "../poems/zephyrflowe.ico"
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Poems</title>
    <link rel="icon" href={favicon}>

    <style>
        body {
            margin: 0;
            background-image: url("background.jpg");
            background-size: 100%;
            background-attachment: fixed;
            color: white;
            font-family: 'Baskerville Old Face', serif;
        }

        header {
            padding: 20px;
        }

        h1 {
            margin: 0;
        }

        .poem {
            margin: 40px;
        }

        .poem-title {
            font-size: 1.2em;
            margin-bottom: 10px;
        }

        .poem-name {
            font-size: 1.4em;
        }

        .poem-text {
            margin-left: 20px;
            /* Changed from 0.7 to 1.3 so lines don't overlap inside the paragraph */
            line-height: 1.3; 
            /* This makes standard Markdown line-breaks render accurately for poetry! */
            white-space: pre-line; 
        }

        .poem-date {
            opacity: 0.7;
        }

        .type {
            font-style: italic;
        }
        
        a:link, a:visited, a:hover {
            color: rgb(255, 255, 255);
        }

        a:active {
            color: rgb(174, 174, 174);
        }

        .extra-links {
            font-size: 0.8em;
        }

        .nav-footer {
            margin-left: 40px;
            font-size: 0.9em;
            opacity: 0.8;
        }
    </style>
</head>

<body>

    <header>
        <a href="/poems">
            <h1>Zephyr Parahoy's Bizarre Strings of Words</h1>
        </a>
    </header>

    <!-- This automatically maps and inserts all your poems! -->
    <PoemList />

    <div class="nav-footer">
        <a href="/interests/poesia">← Back to Poetry Page</a>
    </div>

</body>
</html>


