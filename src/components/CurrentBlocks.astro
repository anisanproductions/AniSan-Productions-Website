---
import aptosfont from "../assets/fonts/Aptos.ttf";

const { production } = Astro.props;

const interestColors: Record<string, string> = {
  "Animation": "#00ff00",
  "Programming": "#001e8c",
  "Blender": "#f57c02",
  "Drawing": "#7d7d7d",
  "Writing": "#aa00ff",
  "Poetry": "#f700ff",
  "English": "#fcfc03",
  "Violin": "#ff0000",
  "Piano": "#ffffff",
  "Composition": "#00ffd5",
  "Editing": "#014006",
};

const interestUrls: Record<string, string> = {
  animation: '/interests/animacion',
  programming: '/interests/programacion',
  blender: '/interests/blender',
  drawing: '/interests/dibujo',
  writing: '/interests/escritura',
  poetry: '/interests/poesia',
  english: '/interests/ingles',
  violin: '/interests/violin',
  piano: '/interests/piano',
  composition: '/interests/composicion',
  editing: '/interests/edicion',
};
---

<div class="current-block">
  {production.data.thumbnail && (
    <div class="thumbnail">
      <img
        src={production.data.thumbnail}
        alt={production.data.title}
      />
    </div>
  )}

  <div class="block-info">

    <div class="interests">
      {production.data.mainInterest && (
        <a
          href={interestUrls[production.data.mainInterest.toLowerCase()] ?? `/interests/${production.data.mainInterest.toLowerCase()}`}
          class="interest"
          style={`color: ${interestColors[production.data.mainInterest] ?? "#ffffff"}`}
        >
          {production.data.mainInterest.toUpperCase()}
        </a>
      )}
    </div>

    <a href={production.data.url} class="title">
        {production.data.title}
    </a>

  </div>
</div>

<style>
  @font-face {
    font-family: 'Aptos';
    src: url("../assets/fonts/Aptos.ttf") format('truetype');
  }

  .current-block {
    width: 100%;
    height: 275px;

    background: black;

    display: grid;
    grid-template-columns: 60% 40%;

    overflow: hidden;
  }

  .thumbnail {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .block-info {
    position: relative;

    display: flex;
    flex-direction: column;

    align-items: center;
    text-align: center;

    padding: 10px 15px;
    box-sizing: border-box;
  }

  .interests {
    width: 100%;

    display: flex;
    justify-content: center;
    gap: 10px;

    font-family: 'Aptos', sans-serif;
    font-size: 16px;
    font-weight: bold;
  }

  .interest {
    white-space: nowrap;
  }

  .title {
    margin: auto 0;

    color: white;

    font-family: 'Aptos', sans-serif;
    font-size: clamp(22px, 2.5vw, 32px);
    line-height: 1.25;

    text-align: center;
  }

  @media (max-width: 750px) {
    .current-block {
      height: auto;
      min-height: 250px;
      grid-template-columns: 55% 45%;
    }

    .title {
      font-size: 22px;
    }

    .interests {
      font-size: 13px;
    }
  }
</style>